# ============================================
# 应用环境配置
# ============================================

# 运行环境: development | production
NODE_ENV=production

# ============================================
# 端口配置
# ============================================

# 前端 Nginx 端口（服务器上映射的端口）
FRONTEND_PORT=80

# 后端 Node.js 端口（服务器上映射的端口）
BACKEND_PORT=3001

# ============================================
# 后端服务配置
# ============================================

# 后端服务内部端口（通常不需要修改）
PORT=3001

# 文件上传目录
UPLOAD_DIR=/app/uploads

# 上传文件大小限制（单位：MB）
MAX_FILE_SIZE=100

# ============================================
# 安全配置
# ============================================

# CORS 允许的源（生产环境设置为你的域名）
# 多个域名用逗号分隔: https://example.com,https://www.example.com
CORS_ORIGIN=*

# API 密钥（如果有的话）
# API_KEY=your-secret-api-key

# JWT 密钥（如果使用 JWT 认证）
# JWT_SECRET=your-jwt-secret-key

# ============================================
# 日志配置
# ============================================

# 日志级别: error | warn | info | debug
LOG_LEVEL=info

# ============================================
# 开发环境配置（仅开发时使用）
# ============================================

# 开发服务器端口
DEV_PORT=5173

# 是否启用热重载
HMR_ENABLED=true
